#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: docker run IMAGE PACKAGE [PACKAGE ...]" >&2
  echo "Example: docker run IMAGE -c conda-forge -c bioconda samtools" >&2
  exit 64
fi

channels=(conda-forge)
packages=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--channel)
      [[ $# -ge 2 ]] || { echo "Missing channel name after $1" >&2; exit 64; }
      channels+=("$2")
      shift 2
      ;;
    -h|--help)
      echo "Usage: test-conda-package [-c CHANNEL]... PACKAGE [PACKAGE ...]"
      exit 0
      ;;
    *)
      packages+=("$1")
      shift
      ;;
  esac
done

if [[ ${#packages[@]} -eq 0 ]]; then
  echo "At least one package is required." >&2
  exit 64
fi

channel_args=()
for channel in "${channels[@]}"; do
  channel_args+=(--channel "$channel")
done

echo "Creating an isolated environment for: ${packages[*]}"
conda create --yes --name package-test "${channel_args[@]}" "${packages[@]}"

echo
echo "Installed packages:"
conda list --name package-test

echo
echo "Conda package test completed successfully."
